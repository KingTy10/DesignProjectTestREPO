@page "/ashapage"
@using BLAZORFORCLASS2.Shared.Data

<PageTitle>ashapage</PageTitle>

<h1>Hardcoded Merch Table</h1>

<table>
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Size</th>
        <th>Quantity</th>
        <th>Sell</th>
    </tr>
    @foreach (var item in Items)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Size</td>
            <td>@item.Quantity</td>
            <td><button class="btn btn-secondary" @onclick="() => SellItem(item)">I sold one</button></td>
        </tr>
    }
</table>

@code {
    public class Item
    {
        public int? Id { get; set; }
        public string? Name { get; set; }
        public string? Size { get; set; }
        public double? Price { get; set; }
        public int? Quantity { get; set; }
    }

    private List<Item> Items = new List<Item>
    {
        new Item { Id = 1, Name = "Blue Shirt", Size = "S", Price = 19.99, Quantity = 10 },
        new Item { Id = 1, Name = "Blue Shirt", Size = "M", Price = 19.99, Quantity = 10 },
        new Item { Id = 1, Name = "Blue Shirt", Size = "L", Price = 19.99, Quantity = 10 },
        new Item { Id = 2, Name = "Tote Bag", Price = 19.99, Quantity = 5 },
        new Item { Id = 3, Name = "Button", Price = 9.99, Quantity = 20 }
    };

    private void SellItem(Item item)
    {
        item.Quantity--;
    }
    //dotnet run -f net9.0-windows10.0.19041.0
}